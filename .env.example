# Discord Developer Portal → Headnote → Bot
DISCORD_TOKEN=
# Optional. Lets the website show its invite button even before the bot connects.
DISCORD_APPLICATION_ID=
# Optional. Enables immediate deployment to one test server instead of global registration.
DISCORD_TEST_GUILD_ID=

# Use host:port without an http://, https://, ws:// or wss:// prefix.
LAVALINK_HOST=
LAVALINK_PASSWORD=
LAVALINK_SECURE=false

# Comma-separated exact public hostnames, with a nonstandard port if required.
DIRECT_AUDIO_HOSTS=
# Optional. Render supplies RENDER_EXTERNAL_URL automatically.
PUBLIC_URL=
# Optional. Point this at your persistent disk if you add one on Render.
SETTINGS_FILE=./data/settings.json
